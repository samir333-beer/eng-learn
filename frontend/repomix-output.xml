import { useRouter } from 'expo-router';
import { useState } from 'react';
import { StyleSheet } from 'react-native';

import { AuthError } from '@/components/auth/AuthError';
import { AuthField } from '@/components/auth/AuthField';
import { AuthFooterLink } from '@/components/auth/AuthFooterLink';
import { AuthHeader } from '@/components/auth/AuthHeader';
import { AuthSocial } from '@/components/auth/AuthSocial';
import { AppButton } from '@/components/ui/AppButton';
import { FadeIn } from '@/components/ui/FadeIn';
import { Screen } from '@/components/ui/Screen';
import { useAuth } from '@/context/AuthContext';
import { sendEmailCode } from '@/lib/api/auth';
import { getApiError } from '@/lib/errors';

export default function RegisterScreen() {
  const router = useRouter();
  const { signInWithGoogle } = useAuth();
  const [email, setEmail] = useState('');
  const [error, setError] = useState('');
  const [loading, setLoading] = useState(false);
  const [googleLoading, setGoogleLoading] = useState(false);

  const handleGoogleSuccess = async (idToken: string) => {
    setError('');
    setGoogleLoading(true);
    try {
      await signInWithGoogle(idToken);
    } catch (e) {
      setError(getApiError(e, 'Ошибка входа через Google'));
    } finally {
      setGoogleLoading(false);
    }
  };

  const onSendCode = async () => {
    setError('');
    if (!email.trim()) {
      setError('Введите email');
      return;
    }
    setLoading(true);
    try {
      await sendEmailCode(email.trim(), 'register');
      // Push (а не replace): системная кнопка «назад» вернёт на этот экран.
      router.push(`./register-code?email=${encodeURIComponent(email.trim())}`);
    } catch (e) {
      setError(getApiError(e, 'Не удалось отправить код'));
    } finally {
      setLoading(false);
    }
  };

  return (
    <Screen scroll>
      <FadeIn>
        <AuthHeader
          icon="person-add-outline"
          title="Начать обучение"
          subtitle="Создайте аккаунт — и учите английский каждый день"
          onBack={() => router.back()}
        />
      </FadeIn>

      <FadeIn delay={100}>
        <AuthField
          label="Email"
          icon="mail-outline"
          placeholder="you@example.com"
          value={email}
          onChangeText={(v) => {
            setEmail(v);
            if (error) setError('');
          }}
          keyboardType="email-address"
          autoComplete="email"
          containerStyle={styles.field}
        />

        {error ? <AuthError message={error} /> : null}

        <AppButton
          title={loading ? 'Отправка кода…' : 'Продолжить'}
          onPress={onSendCode}
          loading={loading}
          style={styles.submit}
        />
      </FadeIn>

      <FadeIn delay={200}>
        <AuthSocial
          onSuccess={handleGoogleSuccess}
          loading={googleLoading}
          dividerText="или зарегистрируйтесь через"
        />

        <AuthFooterLink text="Уже есть аккаунт?" linkText="Войти" href="/(auth)/login" />
      </FadeIn>
    </Screen>
  );
}

const styles = StyleSheet.create({
  field: {
    marginBottom: 16,
  },
  submit: {
    marginBottom: 28,
  },
});
</file>

