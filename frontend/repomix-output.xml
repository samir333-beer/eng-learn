<file path="context/AuthContext.tsx">
import { useRouter, useSegments } from 'expo-router';
import React, {
  createContext,
  useCallback,
  useContext,
  useEffect,
  useMemo,
  useState,
} from 'react';

import {
  fetchMe,
  loginWithEmailCode,
  loginWithGoogle,
  loginWithPassword,
  registerWithEmail,
  type User,
} from '@/lib/api/auth';
import { setAuthToken } from '@/lib/api/client';
import { clearToken, loadToken, saveToken } from '@/lib/storage/token';

type AuthContextValue = {
  user: User | null;
  isLoading: boolean;
  signInPassword: (email: string, password: string) => Promise<void>;
  signInCode: (email: string, code: string) => Promise<void>;
  signInWithGoogle: (idToken: string) => Promise<void>;
  signUp: (
    email: string,
    code: string,
    username: string,
    password: string,
  ) => Promise<void>;
  signOut: () => Promise<void>;
  refreshUser: () => Promise<void>;
};

const AuthContext = createContext<AuthContextValue | null>(null);

export function AuthProvider({ children }: { children: React.ReactNode }) {
  const [user, setUser] = useState<User | null>(null);
  const [isLoading, setIsLoading] = useState(true);
  const router = useRouter();
  const segments = useSegments();

  const applyToken = useCallback(async (token: string) => {
    setAuthToken(token);
    await saveToken(token);
    const me = await fetchMe();
    setUser(me);
  }, []);

  useEffect(() => {
    (async () => {
      try {
        const token = await loadToken();
        if (token) {
          setAuthToken(token);
          setUser(await fetchMe());
        }
      } catch {
        await clearToken();
        setAuthToken(null);
        setUser(null);
      } finally {
        setIsLoading(false);
      }
    })();
  }, []);

  useEffect(() => {
    if (isLoading) return;
    const inAuth = segments[0] === '(auth)';
    if (!user && !inAuth) router.replace('/(auth)/login');
    else if (user && inAuth) router.replace('/(tabs)');
  }, [user, isLoading, segments, router]);

  const signInPassword = useCallback(
    async (email: string, password: string) => {
      const { access_token } = await loginWithPassword(email, password);
      await applyToken(access_token);
    },
    [applyToken],
  );

  const signInCode = useCallback(
    async (email: string, code: string) => {
      const { access_token } = await loginWithEmailCode(email, code);
      await applyToken(access_token);
    },
    [applyToken],
  );

  const signUp = useCallback(
    async (
      email: string,
      code: string,
      username: string,
      password: string,
    ) => {
      const { access_token } = await registerWithEmail(
        email,
        code,
        username,
        password,
      );
      await applyToken(access_token);
    },
    [applyToken],
  );

  const signInWithGoogle = useCallback(
    async (idToken: string) => {
      const { access_token } = await loginWithGoogle(idToken);
      await applyToken(access_token);
    },
    [applyToken],
  );

  const signOut = useCallback(async () => {
    await clearToken();
    setAuthToken(null);
    setUser(null);
    router.replace('/(auth)/login');
  }, [router]);

  const refreshUser = useCallback(async () => {
    if (!user) return;
    setUser(await fetchMe());
  }, [user]);

  const value = useMemo(
    () => ({
      user,
      isLoading,
      signInPassword,
      signInCode,
      signInWithGoogle,
      signUp,
      signOut,
      refreshUser,
    }),
    [
      user,
      isLoading,
      signInPassword,
      signInCode,
      signInWithGoogle,
      signUp,
      signOut,
      refreshUser,
    ],
  );

  return <AuthContext.Provider value={value}>{children}</AuthContext.Provider>;
}

export function useAuth() {
  const ctx = useContext(AuthContext);
  if (!ctx) throw new Error('useAuth must be used within AuthProvider');
  return ctx;
}
</file>

<file path="context/WordsContext.tsx">
import React, {
  createContext,
  useCallback,
  useContext,
  useMemo,
  useState,
} from 'react';

export type UserWord = {
  id: number;
  en: string;
  ru: string;
  level: string;
  topic: string;
  isCustom: true;
};

type WordsContextValue = {
  customWords: UserWord[];
  addWord: (en: string, ru: string, level: string) => UserWord;
};

const WordsContext = createContext<WordsContextValue | null>(null);

let nextId = -1;

export function WordsProvider({ children }: { children: React.ReactNode }) {
  const [customWords, setCustomWords] = useState<UserWord[]>([]);

  const addWord = useCallback((en: string, ru: string, level: string) => {
    const word: UserWord = {
      id: nextId--,
      en: en.trim(),
      ru: ru.trim(),
      level,
      topic: 'Моё слово',
      isCustom: true,
    };
    setCustomWords((prev) => [word, ...prev]);
    return word;
  }, []);

  const value = useMemo(
    () => ({ customWords, addWord }),
    [customWords, addWord],
  );

  return <WordsContext.Provider value={value}>{children}</WordsContext.Provider>;
}

export function useWords() {
  const ctx = useContext(WordsContext);
  if (!ctx) throw new Error('useWords must be used within WordsProvider');
  return ctx;
}
