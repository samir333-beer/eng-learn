                  </Text>
                  <Text style={[styles.value, { color: p.textMuted }]}>
                    {tab === 'words' ? `${entry.value} слов` : formatTime(entry.value)}
                  </Text>
                </View>
              </View>
            );
          })}
        </View>
      )}
    </Screen>
  );
}

