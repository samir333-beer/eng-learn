import { LinearGradient } from 'expo-linear-gradient';
import { useRouter } from 'expo-router';
import { useEffect } from 'react';
import {
  ActivityIndicator,
  BackHandler,
  KeyboardAvoidingView,
  Platform,
  Pressable,
  ScrollView,
  StyleSheet,
  Text,
  View,
} from 'react-native';
import { useSafeAreaInsets } from 'react-native-safe-area-context';

import { AuthField } from '@/components/auth/AuthField';
import { AuthFooterLink } from '@/components/auth/AuthFooterLink';
import { AuthHeader } from '@/components/auth/AuthHeader';
import { FadeIn } from '@/components/ui/FadeIn';
import { AppButton } from '@/components/ui/AppButton';
import { useThemePalette } from '@/hooks/use-theme-palette';
import { useResetPassword } from '@/hooks/useResetPassword';

export default function ResetPasswordScreen() {
  const p = useThemePalette();
  const insets = useSafeAreaInsets();
  const router = useRouter();

  const {
    step,
    email,
    setEmail,
    code,
    setCode,
    newPassword,
    setNewPassword,
    emailError,
    setEmailError,
    sendingCode,
    codeError,
    setCodeError,
    passwordError,
    setPasswordError,
    resetting,
    resendIn,
    resending,
    isResetValid,
    canResend,
    sendCode,
    resendCode,
    resetPassword,
    goBackToEmail,
  } = useResetPassword();

  // Пошаговая навигация «назад»:
  // шаг 'email' (экран 2) → router.back() вернёт на вход (экран 1);
  // шаг 'reset' (экран 3) → goBackToEmail() вернёт на шаг 'email',
  // перескок через шаг невозможен.
  const handleBack = () => {
    if (step === 'reset') {
      goBackToEmail();
    } else {
      router.back();
    }
  };

  // Перехват системной кнопки «назад» на Android: с шага 'reset' возвращаемся
  // на шаг 'email', а не сразу на вход.
  useEffect(() => {
    const subscription = BackHandler.addEventListener('hardwareBackPress', () => {
      if (step === 'reset') {
        goBackToEmail();
        return true; // отменяем стандартную навигацию (ушла бы на вход)
      }
      return false; // стандартная навигация: экран 2 → вход
    });
    return () => subscription.remove();
  }, [step, goBackToEmail]);

  return (
    <View style={[styles.root, { backgroundColor: p.bg }]}>
      <LinearGradient
        colors={[`${p.primary}18`, 'transparent']}
        style={styles.glow}
      />
      <KeyboardAvoidingView
        style={styles.flex}
        behavior={Platform.OS === 'ios' ? 'padding' : undefined}>
        <ScrollView
          showsVerticalScrollIndicator={false}
          contentContainerStyle={styles.scrollContent}
          keyboardShouldPersistTaps="handled">
          <View style={[styles.content, { paddingTop: insets.top + 24 }]}>
            <FadeIn>
              <AuthHeader
                icon="key-outline"
                title="Сброс пароля"
                subtitle={
                  step === 'email'
                    ? 'Введите email — отправим код восстановления'
                    : 'Введите код из письма и новый пароль'
                }
                onBack={handleBack}
              />
            </FadeIn>

            <FadeIn delay={100}>
              <View style={styles.form}>
                {step === 'email' ? (
                  <AuthField
                    label="Email"
                    icon="mail-outline"
                    placeholder="you@example.com"
                    value={email}
                    onChangeText={(v) => {
                      setEmail(v);
                      if (emailError) setEmailError('');
                    }}
                    keyboardType="email-address"
                    autoComplete="email"
                    editable={!sendingCode}
                    error={emailError || undefined}
                  />
                ) : (
                  <>
                    <AuthField
                      label="Код подтверждения"
                      icon="shield-checkmark-outline"
                      placeholder="6-значный код"
                      value={code}
                      onChangeText={(v) => {
                        setCode(v.replace(/[^0-9]/g, ''));
                        if (codeError) setCodeError('');
                      }}
                      keyboardType="number-pad"
                      maxLength={6}
                      editable={!resetting}
                      error={codeError || undefined}
                    />

                    <AuthField
                      label="Новый пароль"
                      icon="lock-closed-outline"
                      placeholder="Минимум 8 символов"
                      value={newPassword}
                      onChangeText={(v) => {
                        setNewPassword(v);
                        if (passwordError) setPasswordError('');
                      }}
                      secure
                      autoCapitalize="none"
                      autoComplete="new-password"
                      editable={!resetting}
                      error={passwordError || undefined}
                    />

                    <View style={styles.resendRow}>
                      <Text style={[styles.resendText, { color: p.textMuted }]}>
                        Не пришёл код?{' '}
                      </Text>
                      {canResend ? (
                        <Pressable
                          onPress={resendCode}
                          disabled={resending}
                          hitSlop={8}>
                          {resending ? (
                            <ActivityIndicator size="small" color={p.primary} />
                          ) : (
                            <Text style={[styles.resendLink, { color: p.primary }]}>
                              Отправить повторно
                            </Text>
                          )}
                        </Pressable>
                      ) : (
                        <Text style={[styles.resendTimer, { color: p.textMuted }]}>
                          Отправить повторно через {resendIn} сек
                        </Text>
                      )}
                    </View>
                  </>
                )}
              </View>
            </FadeIn>

            <FadeIn delay={200}>
              {step === 'email' ? (
                <AppButton
                  title={sendingCode ? 'Отправка…' : 'Отправить код'}
                  onPress={sendCode}
                  loading={sendingCode}
                  style={styles.submit}
                />
              ) : (
                <AppButton
                  title={resetting ? 'Сохранение…' : 'Сбросить пароль'}
                  onPress={resetPassword}
                  loading={resetting}
                  disabled={!isResetValid}
                  style={styles.submit}
                />
              )}

              <AuthFooterLink
                text="Вспомнили пароль?"
                linkText="Войти"
                href="/(auth)/login"
              />
            </FadeIn>
          </View>
        </ScrollView>
      </KeyboardAvoidingView>
    </View>
  );
}

const styles = StyleSheet.create({
  root: { flex: 1 },
  flex: { flex: 1 },
  glow: {
    position: 'absolute',
    top: 0,
    left: 0,
