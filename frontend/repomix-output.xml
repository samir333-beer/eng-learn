import { useLocalSearchParams, useRouter } from 'expo-router';
import { useCallback, useEffect, useRef, useState } from 'react';
import {
  ActivityIndicator,
  BackHandler,
  Pressable,
  StyleSheet,
  Text,
  View,
} from 'react-native';
import { Ionicons } from '@expo/vector-icons';

import { AuthError } from '@/components/auth/AuthError';
import { AuthField, type AuthFieldStatus } from '@/components/auth/AuthField';
import { AuthHeader } from '@/components/auth/AuthHeader';
import { AppButton } from '@/components/ui/AppButton';
import { FadeIn } from '@/components/ui/FadeIn';
import { Screen } from '@/components/ui/Screen';
import { useAuth } from '@/context/AuthContext';
import { sendEmailCode, verifyRegistrationCode } from '@/lib/api/auth';
import { getApiError } from '@/lib/errors';
import { useThemePalette } from '@/hooks/use-theme-palette';

const PASSWORD_MIN_LENGTH = 6;
const RESEND_SECONDS = 60;

type PasswordStatus = 'idle' | 'valid' | 'invalid';

export default function RegisterCodeScreen() {
  const { signUp } = useAuth();
  const router = useRouter();
  const p = useThemePalette();
  const { email } = useLocalSearchParams<{ email: string }>();
  const [code, setCode] = useState('');
  const [username, setUsername] = useState('');
  const [password, setPassword] = useState('');
  const [confirmPassword, setConfirmPassword] = useState('');
  const [error, setError] = useState('');
  const [loading, setLoading] = useState(false);
  const [resending, setResending] = useState(false);
  const [resendIn, setResendIn] = useState(RESEND_SECONDS);
  const [passwordStatus, setPasswordStatus] = useState<PasswordStatus>('idle');
  const [confirmPasswordStatus, setConfirmPasswordStatus] = useState<PasswordStatus>('idle');
  const [codeStatus, setCodeStatus] = useState<AuthFieldStatus>('idle');
  const [codeVerified, setCodeVerified] = useState(false);
  const verifyRequestId = useRef(0);

  const handleBack = () => {
    if (router.canGoBack()) {
      router.back();
    } else {
      router.replace('./register');
    }
  };

  useEffect(() => {
    const subscription = BackHandler.addEventListener('hardwareBackPress', () => {
      handleBack();
      return true;
    });
    return () => subscription.remove();
  }, []);

  // Обратный отсчёт до повторной отправки кода.
  useEffect(() => {
    if (resendIn <= 0) return;
    const timer = setTimeout(() => setResendIn((v) => v - 1), 1000);
    return () => clearTimeout(timer);
  }, [resendIn]);

  const onResendCode = async () => {
    setError('');
    setCodeStatus('idle');
    setCodeVerified(false);
    setResending(true);
    try {
      await sendEmailCode(email, 'register');
      setResendIn(RESEND_SECONDS);
    } catch (e) {
      setError(getApiError(e, 'Не удалось отправить код'));
    } finally {
      setResending(false);
    }
  };

  // Живая валидация паролей: статусы полей обновляются сразу при вводе.
  // idle    — поле пустое (нейтральное);
  // valid   — пароль >= 6 символов и пароли совпадают (зелёный);
  // invalid — слишком короткий или пароли не совпадают (красный).
  const syncPasswordStatuses = useCallback((pass: string, confirm: string) => {
    // trim() обязателен: автозаполнение может добавить пробел в конец,
    // и сравнение без trim() ломается.
    const trimmedPass = pass.trim();
    const trimmedConfirm = confirm.trim();

    if (!trimmedPass) {
      setPasswordStatus('idle');
    } else if (
      trimmedPass.length < PASSWORD_MIN_LENGTH ||
      (trimmedConfirm.length > 0 && trimmedConfirm !== trimmedPass)
    ) {
      setPasswordStatus('invalid');
    } else {
      setPasswordStatus('valid');
    }

    if (!trimmedConfirm) {
      setConfirmPasswordStatus('idle');
    } else if (trimmedConfirm !== trimmedPass) {
      setConfirmPasswordStatus('invalid');
    } else {
      setConfirmPasswordStatus('valid');
    }
  }, []);

  const handlePasswordChange = (text: string) => {
    setPassword(text);
    setError('');
    syncPasswordStatuses(text, confirmPassword);
  };

  const handleConfirmPasswordChange = (text: string) => {
    setConfirmPassword(text);
    setError('');
    syncPasswordStatuses(password, text);
  };

  // Мгновенная проверка кода: как только введены 6 цифр — отправляем запрос,
  // без нажатия кнопок.
  const handleCodeChange = useCallback(
    (text: string) => {
      const digits = text.replace(/\D/g, '').slice(0, 6);
      setCode(digits);
      setError('');
      if (!email) return;

      const requestId = ++verifyRequestId.current;

      if (digits.length === 6) {
        setCodeStatus('loading');
        setCodeVerified(false);
        verifyRegistrationCode(email, digits)
          .then(() => {
            if (verifyRequestId.current !== requestId) return;
            setCodeStatus('valid');
            setCodeVerified(true);
          })
          .catch((err) => {
            if (verifyRequestId.current !== requestId) return;
            setCodeStatus('invalid');
            setCodeVerified(false);
            setError(getApiError(err, 'Проверьте код и попробуйте ещё раз.'));
          });
      } else {
        // Меньше 6 цифр — сбрасываем статус и отменяем «висящий» запрос.
        setCodeStatus('idle');
        setCodeVerified(false);
      }
    },
    [email],
  );

  const onRegister = async () => {
    setError('');
    syncPasswordStatuses(password, confirmPassword);
    if (!codeVerified || code.trim().length !== 6) {
      setError('Сначала введите и подтвердите код из письма');
      return;
    }
    if (username.trim().length < 3) {
      setError('Имя — минимум 3 символа');
      return;
    }
    // trim() для сравнения и отправки — лишний пробел не должен ломать проверку.
    const trimmedPassword = password.trim();
    const trimmedConfirmPassword = confirmPassword.trim();
    if (trimmedPassword.length < PASSWORD_MIN_LENGTH) {
      setError('Пароль — минимум 6 символов');
      return;
    }
    if (trimmedConfirmPassword !== trimmedPassword) {
      setError('Пароли не совпадают');
      return;
    }
    setLoading(true);
    try {
      await signUp(email, code.trim(), username.trim(), trimmedPassword);
    } catch (e) {
      setError(getApiError(e, 'Ошибка регистрации'));
    } finally {
      setLoading(false);
    }
  };

  return (
    <Screen scroll>
      <FadeIn>
        <AuthHeader
          icon="shield-checkmark-outline"
          title="Почти готово"
          subtitle="Введите код из письма и придумайте пароль"
          onBack={handleBack}
        />
      </FadeIn>

      {/* Чип с email: показывает, на какую почту отправлен код */}
      <View style={[styles.emailChip, { backgroundColor: `${p.primary}0F` }]}>
        <Ionicons name="mail-outline" size={16} color={p.primary} />
        <Text style={[styles.emailChipText, { color: p.text }]} numberOfLines={1}>
          {email}
        </Text>
        <Pressable onPress={handleBack} hitSlop={8}>
          <Text style={[styles.emailChipLink, { color: p.primary }]}>Изменить</Text>
        </Pressable>
      </View>

      <FadeIn delay={100}>
        <View style={styles.form}>
          <AuthField
            label="Код из письма"
            icon="shield-checkmark-outline"
            placeholder="6 цифр"
            value={code}
            onChangeText={handleCodeChange}
            keyboardType="number-pad"
            maxLength={6}
            status={codeStatus}
            hint="Код отправлен на указанную почту"
          />

          <AuthField
            label="Имя пользователя"
            icon="person-outline"
            placeholder="Как вас называть?"
            value={username}
            onChangeText={setUsername}
            autoCapitalize="words"
            hint="Минимум 3 символа"
          />

          <AuthField
            label="Пароль"
            icon="lock-closed-outline"
            placeholder="Придумайте пароль"
            value={password}
            onChangeText={handlePasswordChange}
            secure
            autoComplete="new-password"
            status={passwordStatus}
            hint={`Минимум ${PASSWORD_MIN_LENGTH} символов`}
          />

          <AuthField
            label="Повторите пароль"
            icon="lock-closed-outline"
            placeholder="Ещё раз"
            value={confirmPassword}
            onChangeText={handleConfirmPasswordChange}
            secure
            autoComplete="new-password"
            status={confirmPasswordStatus}
          />
        </View>

        {error ? <AuthError message={error} /> : null}

        <AppButton
          title={loading ? 'Создание аккаунта…' : 'Создать аккаунт'}
          onPress={onRegister}
          loading={loading}
          disabled={!codeVerified}
          style={styles.submit}
        />

        <View style={styles.resendRow}>
          <Text style={[styles.resendText, { color: p.textMuted }]}>
            Не пришёл код?{' '}
          </Text>
          {resendIn > 0 ? (
            <Text style={[styles.resendTimer, { color: p.textMuted }]}>
              Повторно через {resendIn} с
            </Text>
          ) : (
            <Pressable onPress={onResendCode} disabled={resending} hitSlop={8}>
              {resending ? (
                <ActivityIndicator size="small" color={p.primary} />
              ) : (
                <Text style={[styles.resendLink, { color: p.primary }]}>
                  Отправить снова
                </Text>
              )}
            </Pressable>
          )}
        </View>
      </FadeIn>
    </Screen>
  );
}

const styles = StyleSheet.create({
  emailChip: {
    flexDirection: 'row',
    alignItems: 'center',
    gap: 8,
    borderRadius: 12,
    paddingHorizontal: 14,
    paddingVertical: 12,
    marginBottom: 20,
  },
  emailChipText: {
    flex: 1,
    fontSize: 14,
    fontWeight: '600',
  },
  emailChipLink: {
    fontSize: 14,
    fontWeight: '700',
  },
  form: {
    gap: 20,
    marginBottom: 8,
  },
  submit: {
    marginBottom: 8,
  },
  resendRow: {
    flexDirection: 'row',
    alignItems: 'center',
    justifyContent: 'center',
    paddingVertical: 16,
  },
  resendText: {
    fontSize: 14,
  },
  resendTimer: {
    fontSize: 14,
    fontWeight: '500',
  },
  resendLink: {
    fontSize: 14,
    fontWeight: '700',
  },
});
