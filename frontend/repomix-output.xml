import { Link } from 'expo-router';
import { useState } from 'react';
import { ActivityIndicator, StyleSheet, View } from 'react-native';

import { AuthError } from '@/components/auth/AuthError';
import { AuthField } from '@/components/auth/AuthField';
import { AuthFooterLink } from '@/components/auth/AuthFooterLink';
import { AuthHeader } from '@/components/auth/AuthHeader';
import { AuthSocial } from '@/components/auth/AuthSocial';
import { AppButton } from '@/components/ui/AppButton';
import { FadeIn } from '@/components/ui/FadeIn';
import { Screen } from '@/components/ui/Screen';
import { useAuth } from '@/context/AuthContext';
import { getApiError } from '@/lib/errors';
import { useThemePalette } from '@/hooks/use-theme-palette';

export default function LoginScreen() {
  const { signInPassword, signInWithGoogle, isLoading: authLoading } = useAuth();
  const p = useThemePalette();
  const [email, setEmail] = useState('');
  const [password, setPassword] = useState('');
  const [error, setError] = useState('');
  const [submitting, setSubmitting] = useState(false);
  const [googleLoading, setGoogleLoading] = useState(false);

  const onSubmit = async () => {
    setError('');
    setSubmitting(true);
    try {
      await signInPassword(email.trim(), password);
    } catch (e) {
      setError(getApiError(e, 'Ошибка входа'));
    } finally {
      setSubmitting(false);
    }
  };

  const handleGoogleSuccess = async (idToken: string) => {
    setError('');
    setGoogleLoading(true);
    try {
      await signInWithGoogle(idToken);
    } catch (e) {
      setError(getApiError(e, 'Ошибка входа через Google'));
    } finally {
      setGoogleLoading(false);
    }
  };

  if (authLoading) {
    return (
      <Screen>
        <ActivityIndicator size="large" color={p.primary} style={{ marginTop: 80 }} />
      </Screen>
    );
  }

  return (
    <Screen scroll>
      <FadeIn>
        <AuthHeader
          icon="log-in-outline"
          title="С возвращением 👋"
          subtitle="Войдите, чтобы продолжить обучение"
        />
      </FadeIn>

      <FadeIn delay={100}>
        <View style={styles.form}>
          <AuthField
            label="Email"
            icon="mail-outline"
            placeholder="you@example.com"
            value={email}
            onChangeText={setEmail}
            keyboardType="email-address"
            autoComplete="email"
          />

          <AuthField
            label="Пароль"
            icon="lock-closed-outline"
            placeholder="Ваш пароль"
            value={password}
            onChangeText={setPassword}
            secure
            autoComplete="password"
          />
        </View>

        <Link href="/(auth)/reset-password" style={[styles.forgotLink, { color: p.primary }]}>
          Забыли пароль?
        </Link>

        {error ? <AuthError message={error} /> : null}
      </FadeIn>

      <FadeIn delay={200}>
        <AppButton
          title={submitting ? 'Вход…' : 'Войти'}
          onPress={onSubmit}
          loading={submitting}
          style={styles.submit}
        />

        <AuthSocial
          onSuccess={handleGoogleSuccess}
          loading={googleLoading}
          dividerText="или войдите через"
        />

        <AuthFooterLink
          text="Ещё нет аккаунта?"
          linkText="Зарегистрироваться"
          href="/(auth)/register"
        />
      </FadeIn>
    </Screen>
  );
}

const styles = StyleSheet.create({
  form: {
    gap: 20,
    marginBottom: 4,
  },
  forgotLink: {
    alignSelf: 'flex-end',
    fontSize: 14,
    fontWeight: '600',
    paddingVertical: 12,
    marginBottom: 4,
  },
  submit: {
    marginBottom: 28,
  },
});
