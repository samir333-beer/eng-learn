import { useState, type ComponentProps } from 'react';
import {
  ActivityIndicator,
  Pressable,
  StyleSheet,
  Text,
  TextInput,
  View,
  type TextInputProps,
  type ViewStyle,
} from 'react-native';
import { Ionicons } from '@expo/vector-icons';

import { useThemePalette } from '@/hooks/use-theme-palette';

export type AuthFieldStatus = 'idle' | 'valid' | 'invalid' | 'loading';

type Props = TextInputProps & {
  label: string;
  icon: ComponentProps<typeof Ionicons>['name'];
  /** Визуальный статус: иконка справа и цвет рамки. */
  status?: AuthFieldStatus;
  /** Текст ошибки под полем (рамка становится красной). */
  error?: string;
  /** Нейтральная подсказка под полем. */
  hint?: string;
  /** Показать кнопку «показать/скрыть пароль». */
  secure?: boolean;
  containerStyle?: ViewStyle;
};

/**
 * Единое поле ввода для экранов авторизации: лейбл, иконка, рамка с фокусом,
 * статус-иконка, переключатель видимости пароля, ошибка/подсказка снизу.
 * Рамка всегда одной толщины (меняется только цвет) — интерфейс не «прыгает».
 */
export function AuthField({
  label,
  icon,
  status = 'idle',
  error,
  hint,
  secure,
  containerStyle,
  style,
  onFocus,
  onBlur,
  ...inputProps
}: Props) {
  const p = useThemePalette();
  const [focused, setFocused] = useState(false);
  const [visible, setVisible] = useState(false);

  const hasError = Boolean(error) || status === 'invalid';
  const borderColor = hasError ? p.danger : focused ? p.primary : p.border;
  const iconColor = hasError ? p.danger : focused ? p.primary : p.textMuted;

  return (
    <View style={containerStyle}>
      <Text style={[styles.label, { color: p.textMuted }]}>{label}</Text>

      <View style={[styles.row, { backgroundColor: p.card, borderColor }]}>
        <Ionicons name={icon} size={20} color={iconColor} />

        <TextInput
          placeholderTextColor="#9AA4B8"
          selectionColor={p.primary}
          autoCapitalize="none"
          {...inputProps}
          secureTextEntry={secure ? !visible : inputProps.secureTextEntry}
          onFocus={(e) => {
            setFocused(true);
            onFocus?.(e);
          }}
          onBlur={(e) => {
            setFocused(false);
            onBlur?.(e);
          }}
          style={[styles.input, { color: p.text }, style]}
        />

        {status === 'loading' && (
          <ActivityIndicator size="small" color={p.primary} style={styles.status} />
        )}
        {status === 'valid' && (
          <Ionicons
            name="checkmark-circle"
            size={22}
            color={p.accent}
            style={styles.status}
          />
        )}
        {status === 'invalid' && (
          <Ionicons
            name="close-circle"
            size={22}
            color={p.danger}
            style={styles.status}
          />
        )}

        {secure && (
          <Pressable
            onPress={() => setVisible((v) => !v)}
            hitSlop={8}
            style={styles.eye}>
            <Ionicons
              name={visible ? 'eye-outline' : 'eye-off-outline'}
              size={20}
              color={p.textMuted}
            />
          </Pressable>
        )}
      </View>

      {error ? (
        <View style={styles.errorRow}>
          <Ionicons name="alert-circle" size={14} color={p.danger} />
          <Text style={[styles.errorText, { color: p.danger }]}>{error}</Text>
        </View>
      ) : hint ? (
        <Text style={[styles.hintText, { color: p.textMuted }]}>{hint}</Text>
      ) : null}
    </View>
  );
}

const styles = StyleSheet.create({
  label: {
    fontSize: 13,
    fontWeight: '600',
    marginBottom: 8,
    marginLeft: 4,
  },
  row: {
    flexDirection: 'row',
    alignItems: 'center',
    borderWidth: 1.5,
    borderRadius: 16,
    paddingHorizontal: 16,
    gap: 12,
  },
  input: {
    flex: 1,
    paddingVertical: 16,
    fontSize: 15,
    fontWeight: '500',
  },
  status: {
    width: 24,
  },
  eye: {
    width: 28,
    alignItems: 'center',
    justifyContent: 'center',
  },
  errorRow: {
    flexDirection: 'row',
    alignItems: 'center',
    gap: 6,
    marginTop: 8,
    marginLeft: 4,
  },
  errorText: {
    flex: 1,
    fontSize: 13,
    lineHeight: 18,
  },
  hintText: {
    fontSize: 13,
    marginTop: 8,
    marginLeft: 4,
  },
});
</file>

