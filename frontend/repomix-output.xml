<file path="hooks/useGoogleAuth.ts">
import * as Google from 'expo-auth-session/providers/google';
import * as WebBrowser from 'expo-web-browser';
import { useEffect, useState } from 'react';

WebBrowser.maybeCompleteAuthSession();

/**
 * Хук входа через Google.
 *
 * На нативных платформах expo-auth-session (7.x) намеренно использует
 * authorization code flow (ResponseType.Code): Google не отдаёт id_token напрямую
 * для Android/iOS OAuth-клиентов. После возврата из браузера библиотека
 * автоматически обменивает `code` на токены (PKCE) и кладёт id_token в
 * `response.params.id_token` / `response.authentication.idToken`.
 *
 * Redirect URI генерируется библиотекой автоматически через makeRedirectUri():
 * - Development build: `${applicationId}:/oauthredirect` = `com.samir.ingich:/oauthredirect`
 *   (схема com.samir.ingich зарегистрирована expo-router в AndroidManifest)
 * - Expo Go: через Linking.createURL с scheme из app.json
 *
 * Хук следит за ответом и возвращает id_token, который затем отправляется
 * на бэкенд (POST /auth/google).
 */
export function useGoogleAuth() {
  const [request, response, promptAsync] = Google.useAuthRequest({
    // Все три client id обязательны: библиотека выбирает нужный по платформе
    // (web -> webClientId, iOS -> iosClientId, Android -> androidClientId)
    // и бросает ошибку "...ClientId must be defined", если он не передан.
    webClientId: process.env.EXPO_PUBLIC_GOOGLE_WEB_CLIENT_ID,
    iosClientId: process.env.EXPO_PUBLIC_GOOGLE_IOS_CLIENT_ID,
    androidClientId: process.env.EXPO_PUBLIC_GOOGLE_ANDROID_CLIENT_ID,
  });

  const [idToken, setIdToken] = useState<string | null>(null);

  useEffect(() => {
    if (response?.type !== 'success') return;

    // В этой версии expo-auth-session (7.x) id_token лежит в query-параметрах
    // ответа (response.params.id_token), а после автообмена кода также
    // доступен в response.authentication?.idToken.
    const token = response.params.id_token ?? response.authentication?.idToken;
    if (token) {
      setIdToken(token);
    }
  }, [response]);

  return {
    promptAsync,
    idToken,
    // true, пока auth-запрос ещё не загружен (кнопка входа недоступна).
    loading: request === null,
  };
}
</file>

<file path="hooks/useResetPassword.ts">
import { useRouter } from 'expo-router';
import { useCallback, useEffect, useRef, useState } from 'react';
import { Alert } from 'react-native';

import { forgotPassword, resetPassword } from '@/lib/api/auth';
import { getApiError } from '@/lib/errors';

const RESEND_SECONDS = 60;

const EMAIL_REGEX = /^[^\s@]+@[^\s@]+\.[^\s@]+$/;

export type ResetPasswordStep = 'email' | 'reset';

export function useResetPassword() {
  const router = useRouter();

  const [step, setStep] = useState<ResetPasswordStep>('email');
  const [email, setEmail] = useState('');
  const [code, setCode] = useState('');
  const [newPassword, setNewPassword] = useState('');
  const [showPassword, setShowPassword] = useState(false);

  // Step 1 state
  const [emailError, setEmailError] = useState('');
  const [sendingCode, setSendingCode] = useState(false);

  // Step 2 state
  const [codeError, setCodeError] = useState('');
  const [passwordError, setPasswordError] = useState('');
  const [resetting, setResetting] = useState(false);

  // Resend timer
  const [resendIn, setResendIn] = useState(RESEND_SECONDS);
  const [resending, setResending] = useState(false);
  const timerRef = useRef<ReturnType<typeof setInterval> | null>(null);

  useEffect(() => {
    if (step !== 'reset') return;
    setResendIn(RESEND_SECONDS);
    timerRef.current = setInterval(() => {
      setResendIn((prev) => {
        if (prev <= 1) {
          if (timerRef.current) clearInterval(timerRef.current);
          return 0;
        }
        return prev - 1;
      });
    }, 1000);
    return () => {
      if (timerRef.current) clearInterval(timerRef.current);
    };
  }, [step]);

  const validateEmail = (value: string): string => {
    const trimmed = value.trim();
    if (!trimmed) return 'Введите email';
    if (!EMAIL_REGEX.test(trimmed)) return 'Введите корректный email';
    return '';
  };

  const handleSendCode = async () => {
    setEmailError('');
    const err = validateEmail(email);
    if (err) {
      setEmailError(err);
      return;
    }
    setSendingCode(true);
    try {
      await forgotPassword(email.trim());
      setStep('reset');
    } catch (e) {
      setEmailError(getApiError(e, 'Не удалось отправить код'));
    } finally {
      setSendingCode(false);
    }
  };

  const handleResendCode = async () => {
    if (resendIn > 0 || resending) return;
    setEmailError('');
    setResending(true);
    try {
      await forgotPassword(email.trim());
      setResendIn(RESEND_SECONDS);
      timerRef.current = setInterval(() => {
        setResendIn((prev) => {
          if (prev <= 1) {
            if (timerRef.current) clearInterval(timerRef.current);
            return 0;
          }
          return prev - 1;
        });
      }, 1000);
    } catch (e) {
      Alert.alert('Ошибка', getApiError(e, 'Не удалось отправить код повторно'));
    } finally {
      setResending(false);
    }
  };

  const isResetValid =
    /^\d{6}$/.test(code.trim()) && newPassword.length >= 8;

  const handleResetPassword = async () => {
    setCodeError('');
    setPasswordError('');

    if (!/^\d{6}$/.test(code.trim())) {
      setCodeError('Введите 6-значный код из письма');
      return;
    }
    if (newPassword.length < 8) {
      setPasswordError('Пароль должен быть не короче 8 символов');
      return;
    }

    setResetting(true);
    try {
      await resetPassword(email.trim(), code.trim(), newPassword);
      Alert.alert('Пароль изменён', 'Теперь вы можете войти с новым паролем.', [
        { text: 'ОК', onPress: () => router.replace('/(auth)/login') },
      ]);
    } catch (e) {
      const status = (e as { response?: { status?: number } })?.response?.status;
      const message = getApiError(e, 'Не удалось сбросить пароль');
      if (status === 400) {
        setCodeError(message);
      } else if (status === 422) {
        setPasswordError(message);
      } else {
        Alert.alert('Ошибка', message);
      }
    } finally {
      setResetting(false);
    }
  };

  const canResend = resendIn === 0 && !resending;

  // Stepwise back navigation: from step 'reset' (screen 3) return to step 'email' (screen 2).
  // This keeps the flow strictly stepwise — the user must go through the email step
  // before reaching the login screen, never skipping a step.
  const goBackToEmail = useCallback(() => {
    if (timerRef.current) clearInterval(timerRef.current);
    setStep('email');
    setCode('');
    setNewPassword('');
    setCodeError('');
    setPasswordError('');
    setResendIn(RESEND_SECONDS);
    // eslint-disable-next-line react-hooks/exhaustive-deps
  }, []);

  return {
    step,
    email,
    setEmail,
    code,
    setCode,
    newPassword,
    setNewPassword,
    showPassword,
    setShowPassword,
    emailError,
    setEmailError,
    sendingCode,
    codeError,
    setCodeError,
    passwordError,
    setPasswordError,
    resetting,
    resendIn,
    resending,
    isResetValid,
    canResend,
    sendCode: handleSendCode,
    resendCode: handleResendCode,
    resetPassword: handleResetPassword,
    goBackToEmail,
  };
}
</file>

<file path="hooks/useStudyTimer.ts">
import { useEffect } from 'react';
import { AppState, type AppStateStatus } from 'react-native';

import { reportStudyTime } from '@/lib/api/leaderboard';

const SYNC_INTERVAL_SEC = 30;

export function useStudyTimer(enabled: boolean) {
  useEffect(() => {
    if (!enabled) return;

    let activeSince = Date.now();
    let pendingSeconds = 0;
    let intervalId: ReturnType<typeof setInterval> | null = null;

    const flush = async () => {
      if (pendingSeconds < 1) return;
      const batch = Math.min(pendingSeconds, 300);
      pendingSeconds -= batch;
      try {
        await reportStudyTime(batch);
      } catch {
        pendingSeconds += batch;
      }
    };

    const tick = () => {
      const now = Date.now();
      const elapsed = Math.floor((now - activeSince) / 1000);
      if (elapsed > 0) {
        pendingSeconds += elapsed;
        activeSince = now;
      }
      if (pendingSeconds >= SYNC_INTERVAL_SEC) {
        void flush();
      }
    };

    const onAppState = (state: AppStateStatus) => {
      if (state === 'active') {
        activeSince = Date.now();
        intervalId = setInterval(tick, 1000);
      } else {
        tick();
        void flush();
        if (intervalId) {
          clearInterval(intervalId);
          intervalId = null;
        }
      }
    };

    intervalId = setInterval(tick, 1000);
    const sub = AppState.addEventListener('change', onAppState);

    return () => {
      tick();
      void flush();
      if (intervalId) clearInterval(intervalId);
      sub.remove();
    };
  }, [enabled]);
}
</file>

<file path="lib/api/auth.ts">
import { apiClient } from '@/lib/api/client';

export type User = {
  id: number;
  email: string;
  username: string;
};

export type TokenResponse = {
  access_token: string;
  token_type: string;
};

export async function sendEmailCode(
  email: string,
