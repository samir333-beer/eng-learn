# DATABASE_URL=sqlite:///./english_app.db
# DATABASE_URL=postgresql://english_user:english_pass@db:5432/english_app

# Обязательно: сгенерируйте свой ключ (например: python -c "import secrets; print(secrets.token_urlsafe(64))")
SECRET_KEY=change-me-in-production-use-long-random-string
ACCESS_TOKEN_EXPIRE_MINUTES=10080
CODE_EXPIRE_MINUTES=10
APP_ENV=development

# Разрешённые источники CORS (через запятую)
CORS_ORIGINS=http://localhost:8081,http://localhost:19006,exp://localhost:8081

# Gmail SMTP (пароль приложения, а не обычный пароль аккаунта!)
# Как получить App Password: Google Account → Security → 2-Step Verification → App Passwords
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_EMAIL=samirfaizov2010@gmail.com
SMTP_APP_PASSWORD=